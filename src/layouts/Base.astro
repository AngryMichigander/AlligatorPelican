---
import '../styles/global.css';
import NetworkFooter from '../components/NetworkFooter.astro';

interface Props {
  title?: string;
}

const { title = 'AlligatorPelican' } = Astro.props;
const pageTitle = title === 'AlligatorPelican' ? title : `${title} — AlligatorPelican`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo" aria-label="alligatorpelican.com — home">
        <svg
          class="site-logo__mark"
          viewBox="0 0 60 32"
          width="60"
          height="32"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="square"
          stroke-linejoin="miter"
          aria-hidden="true"
          focusable="false"
        >
          {/* A */}
          <path d="M5 30 L15 4 L25 30" />
          <path d="M9 22 L21 22" />
          {/* P */}
          <path d="M35 30 L35 4 L47 4 A 6 6 0 0 1 47 16 L35 16" />
        </svg>
        <span class="site-logo__text">ALLIGATORPELICAN</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/#cost">Cost</a>
        <a href="/#harm">Harm</a>
        <a href="/#human-cost">Human Cost</a>
        <a href="/sources">Sources</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="site-footer__disclaimer">
        This site is political commentary and advocacy.
        Factual claims are cited; opinions are labeled.
        Corrections: <a href="mailto:corrections@alligatorpelican.com">corrections@alligatorpelican.com</a>
      </p>
      <nav class="site-footer__nav" aria-label="Footer navigation">
        <a href="/about">About</a>
        <a href="/methodology">Methodology</a>
        <a href="/sources">Sources</a>
        <a href="/changelog">Changelog</a>
      </nav>
    </footer>
    <NetworkFooter />
  </body>
</html>
